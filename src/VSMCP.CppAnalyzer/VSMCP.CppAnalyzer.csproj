<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VSMCP.CppAnalyzer</RootNamespace>
    <AssemblyName>vsmcp-cppanalyzer</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClangSharp" Version="20.1.6" />
    <!--
      libclang native binaries by RID. Only the runtime matching the active
      RuntimeIdentifier is bundled into a self-contained publish, so adding the
      others is cheap (zero impact on the win-x64 VSIX bundle) and lets a
      future cross-platform build (`dotnet publish -r linux-x64`/`osx-arm64`)
      pick up libclang automatically.
    -->
    <PackageReference Include="libclang.runtime.win-x64" Version="20.1.6" />
    <PackageReference Include="libclang.runtime.linux-x64" Version="20.1.6" Condition="'$(SkipNonWindowsRuntimes)' != 'true'" />
    <!-- libclang.runtime.osx-x64 stalled at 18.1.3 (Apple silicon only past then); drop it to keep
         the version pinned across all RIDs. Intel macOS users would need manual libclang setup. -->
    <PackageReference Include="libclang.runtime.osx-arm64" Version="20.1.6" Condition="'$(SkipNonWindowsRuntimes)' != 'true'" />
    <PackageReference Include="StreamJsonRpc" Version="2.19.27" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VSMCP.Shared\VSMCP.Shared.csproj" />
  </ItemGroup>
</Project>
