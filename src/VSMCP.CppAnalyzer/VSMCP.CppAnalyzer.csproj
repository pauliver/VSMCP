<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VSMCP.CppAnalyzer</RootNamespace>
    <AssemblyName>vsmcp-cppanalyzer</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClangSharp" Version="20.1.6" />
    <PackageReference Include="libclang.runtime.win-x64" Version="20.1.6" />
    <PackageReference Include="StreamJsonRpc" Version="2.19.27" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VSMCP.Shared\VSMCP.Shared.csproj" />
  </ItemGroup>
</Project>
